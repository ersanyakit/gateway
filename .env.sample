
MASTER_KEY="replace-with-32-byte-or-longer-secret-from-secret-manager"
DATABASE_URL="host=127.0.0.1 port=5432 user=postgres password=postgres dbname=gateway sslmode=disable"
PORT=":3001"
APP_ENV="development"
GATEWAY_LOG_FORMAT="text"
GATEWAY_LOG_LEVEL="info"
HTTP_READ_TIMEOUT="15s"
HTTP_WRITE_TIMEOUT="30s"
HTTP_IDLE_TIMEOUT="60s"
CORS_ALLOWED_ORIGINS="http://localhost:3001"
# Optional x402 v2 seller support. Both modes are disabled by default.
# Generic static resources use a fixed receiver and Base Sepolia defaults:
X402_ENABLED="false"
# X402_FACILITATOR_URL="https://x402.org/facilitator"
# X402_NETWORKS="eip155:84532"
# X402_PAY_TO="0xYourEvmReceiverAddress"
# X402_PRICE="$0.001"
# X402_ROUTES="GET /your-paid-route"
# Payment-link x402 is configured by the merchant on link creation (x402
# enabled only). The checkout asset supplies the network; payTo and amount
# come from the session, so no checkout-specific env flag or receiver is needed.
# X402_SYNC_FACILITATOR_ON_START="true"
# X402_TIMEOUT="30s"
ALLOW_PRIVATE_WEBHOOK_URLS="true"
PROVIDER_FAILOVER_STRATEGY="prefer_healthy"
PROVIDER_HEALTH_INTERVAL="1m"
PROVIDER_HEALTH_TIMEOUT="8s"
CHAIN_RPC_ENDPOINT_TIMEOUT="12s"
ALLOW_AUTOMIGRATE_IN_PRODUCTION="false"
SIGNER_MODE="software"
ALLOW_SOFTWARE_SIGNER_IN_PRODUCTION="false"
# Production custody uses your own remote signer service, not the gateway process.
# Set SIGNER_MODE to first-party, custody-signer, vault, hsm, kms, or mpc and point
# the gateway at the signer boundary. HMAC is required when APP_ENV=production.
CUSTODY_SIGNER_URL=""
CUSTODY_SIGNER_PROVIDER="first-party-custody"
CUSTODY_SIGNER_HMAC_SECRET=""
CUSTODY_SIGNER_BEARER_TOKEN=""
CUSTODY_SIGNER_TIMEOUT="10s"
METRICS_BEARER_TOKEN=""
PORTAL_JWT_SECRET="replace-with-32-byte-or-longer-secret-from-secret-manager"
MNEMONIC_PHRASE="replace-with-development-only-bip39-mnemonic"
TRON_GRPC_ENDPOINTS="grpc.trongrid.io:50051"
TRON_TESTNET_JSONRPC_URLS="https://nile.trongrid.io/jsonrpc"
TRON_TESTNET_HTTP_ENDPOINTS="https://nile.trongrid.io"
TRON_TESTNET_GRPC_ENDPOINTS="grpc.nile.trongrid.io:50051"
 
TRON_TESTNET_SWEEP_ADDRESS=""
 

OIDC_ISSUER_URL="https://login.researchcave.com"

OIDC_AUTH_URL="https://login.researchcave.com/oauth2/authorize"
OIDC_TOKEN_URL="https://login.researchcave.com/oauth2/token"
OIDC_USERINFO_URL="https://login.researchcave.com/oauth2/userinfo"

OIDC_PROVIDER_NAME="RESEARCHCAVE"
OIDC_CLIENT_ID="kewlswap-gateway"
OIDC_CLIENT_SECRET="YOUR_OIDC_CLIENT_SECRET_KEY_HERE"
OIDC_REDIRECT_URI="http://localhost:3001/auth/oidc/callback"
OIDC_SCOPES="openid,profile,email,roles"
